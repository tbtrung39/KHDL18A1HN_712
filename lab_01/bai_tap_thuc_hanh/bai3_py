import math

# Nhập bán kính và chiều cao
r = float(input("Nhập bán kính r: "))
h = float(input("Nhập chiều cao h: "))

# Tính diện tích xung quanh, diện tích toàn phần và thể tích
dien_tich_xq = 2 * math.pi * r * h
dien_tich_tp = dien_tich_xq + 2 * math.pi * r**2
the_tich = math.pi * r**2 * h

# Xuất kết quả
print("\n--- Kết quả tính toán ---")
print(f"Diện tích xung quanh: {dien_tich_xq:.2f}")
print(f"Diện tích toàn phần: {dien_tich_tp:.2f}")
print(f"Thể tích khối trụ: {the_tich:.2f}")