def doi_xung_oxy(x, y, z):
    return (x, y, -z)

def doi_xung_oxz(x, y, z):
    return (x, -y, z)

def doi_xung_oyz(x, y, z):
    return (-x, y, z)

x = float(input("Nhập tọa độ x: "))
y = float(input("Nhập tọa độ y: "))
z = float(input("Nhập tọa độ z: "))

print(f"Điểm đối xứng qua mặt phẳng Oxy: {doi_xung_oxy(x, y, z)}")
print(f"Điểm đối xứng qua mặt phẳng Oxz: {doi_xung_oxz(x, y, z)}")
print(f"Điểm đối xứng qua mặt phẳng Oyz: {doi_xung_oyz(x, y, z)}")
